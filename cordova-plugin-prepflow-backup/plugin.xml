<?xml version="1.0" encoding="UTF-8"?>
<plugin id="cordova-plugin-prepflow-backup" version="1.0.0"
        xmlns="http://apache.org/cordova/ns/plugins/1.0"
        xmlns:android="http://schemas.android.com/apk/res/android">
  <name>PrepFlow Backup</name>
  <description>Native Android Storage Access Framework backup and restore for PrepFlow.</description>
  <js-module src="www/prepflow-backup.js" name="PrepFlowBackup">
    <clobbers target="PrepFlowBackup" />
  </js-module>
  <feature name="PrepFlowBackup">
    <param name="android-package" value="com.minecade.prepflow.backup.PrepFlowBackup" />
  </feature>
  <platform name="android">
    <source-file src="src/android/PrepFlowBackup.java" target-dir="src/com/minecade/prepflow/backup" />
  </platform>
</plugin>
